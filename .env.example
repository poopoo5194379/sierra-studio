# Public URL of the deployed Cloudflare Worker (workers/api.ts).
# Used by the renderer's cloud-client.ts to upload snapshots.
# Leave blank to disable cloud features entirely.
VITE_CLOUD_API_URL=

# Worker secrets/configuration (set with Wrangler, do not commit real values):
# ALLOWED_ORIGINS=http://127.0.0.1:5173,null
# ADMIN_TOKEN=replace-with-a-long-random-secret
