{
  "name": "sierra-studio",
  "productName": "SierraStudio",
  "version": "0.3.11",
  "private": true,
  "description": "SierraStudio - a local-first visual HTML editor and PDF export studio.",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/copy-runtime-vendors.cjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/copy-runtime-vendors.cjs",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/ensure-electron-path.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p workers/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node scripts/verify-dev-runtime.cjs",
    "test:e2e:full": "node scripts/verify-all-features.cjs",
    "test:pptx": "node scripts/verify-pptx-export.cjs",
    "security:audit": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "release:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-security.ps1 -ReleaseDirectory release",
    "check": "npm run typecheck && npm test && npm run build",
    "postbuild": "node scripts/post-build.cjs",
    "pack": "npm run build && electron-builder --win --x64 --config.electronDist=\"node_modules\\electron\\dist\" && npm run postbuild",
    "pack:dir": "npm run build && electron-builder --win --x64 --dir --config.electronDist=\"node_modules\\electron\\dist\" && npm run postbuild",
    "pack:mac": "npm run build && electron-builder --mac dmg --x64 --arm64"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@fontsource-variable/open-sans": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@tailwindcss/browser": "4.3.3",
    "alpinejs": "3.15.12",
    "animejs": "3.2.2",
    "aos": "2.3.4",
    "bootstrap": "5.3.8",
    "chart.js": "4.4.1",
    "d3": "7.9.0",
    "dom-to-pptx": "^2.1.1",
    "echarts": "^5.6.0",
    "echarts-wordcloud": "^2.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "gsap": "3.15.0",
    "highcharts": "13.0.0",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.12",
    "lucide-react": "^1.27.0",
    "mermaid": "11.16.0",
    "pdf-lib": "^1.17.1",
    "plotly.js-dist-min": "3.7.0",
    "postcss": "^8.5.6",
    "postcss-value-parser": "^4.2.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "swiper": "14.0.7",
    "three": "0.160.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@swc/core": "^1.13.3",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.54.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.sierrastudio.app",
    "productName": "SierraStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/**/*.js.map",
      "!out/**/*.ts"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "artifactName": "${productName} Setup ${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SierraStudio"
    },
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "poopoo5194379",
        "repo": "sierra-studio",
        "releaseType": "release"
      }
    ]
  }
}
